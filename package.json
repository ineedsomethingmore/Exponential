{
  "name": "exponential",
  "productName": "Exponential",
  "version": "0.4.1",
  "description": "Simple team planning: the big plan and the week, side by side.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "dist": "vite build && node mcp/bundle.mjs && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "vite build && electron-builder --mac --config electron-builder.config.cjs",
    "dist:win": "vite build && electron-builder --win --config electron-builder.config.cjs",
    "release": "vite build && node mcp/bundle.mjs && electron-builder --mac --config electron-builder.config.cjs --publish always",
    "release:win": "vite build && node mcp/bundle.mjs && electron-builder --win --config electron-builder.config.cjs --publish always"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@paper-design/shaders-react": "^0.0.80",
    "@supabase/supabase-js": "^2.112.3",
    "electron-updater": "^6.8.9",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tus-js-client": "^4.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rasmushauschild/Exponential.git"
  }
}
